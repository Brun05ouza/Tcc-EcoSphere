REACT_APP_API_URL=http://localhost:4000

# Opcional: chave Gemini (chat/segunda opinião). Padrão: desligado no classificador.
REACT_APP_GEMINI_API_KEY=sua_chave_gemini

# Opcional: permite trocar o modelo sem alterar o código em futuras descontinuações
REACT_APP_GEMINI_MODEL=gemini-3.5-flash

# Classificador local
# Sem model.json a página entra sozinha em "modo estimativa" (não precisa de NN treinada).
# REACT_APP_USE_MOCK_MODEL=true → força modo estimativa
# REACT_APP_REQUIRE_REAL_MODEL=true → bloqueia a página se não houver model.json
# REACT_APP_ENABLE_SIMULATED=true → heurística por nome/cor (só desenvolvimento)
# REACT_APP_ENABLE_GEMINI_SECOND_OPINION=true → botão "Pedir segunda opinião" (exige chave)
REACT_APP_USE_MOCK_MODEL=false
REACT_APP_REQUIRE_REAL_MODEL=false
REACT_APP_ENABLE_SIMULATED=false
REACT_APP_ENABLE_GEMINI_SECOND_OPINION=false

# Opcional: use se for rodar o ai-service Flask em http://localhost:8000
REACT_APP_AI_SERVICE_URL=http://localhost:8000

# Opcional: fallback de clima (nivel 2) quando Open-Meteo falhar
# REACT_APP_OPENWEATHER_API_KEY=sua_chave_openweathermap_aqui
